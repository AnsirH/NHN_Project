  text: "\uC7A0\uC2DC \uB300\uC5F4\uC774 \uBA48\uCD98 \uC0AC\uC774, \uD759\uC778\uD615
    \uD558\uB098\uAC00 \uB545\uC5D0 \uC190\uAC00\uB77D\uC73C\uB85C \uC9E7\uC740 \uC120\uC744
