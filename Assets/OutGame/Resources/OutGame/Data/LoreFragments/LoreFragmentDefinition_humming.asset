  fragmentId: humming
  text: "\uC57C\uC601 \uC911, \uBCF4\uCD08\uB97C \uC11C\uB358 \uD759\uC778\uD615
    \uD558\uB098\uAC00 \uB0AE\uAC8C \uCF67\uB178\uB798 \uAC19\uC740 \uC18C\uB9AC\uB97C
