  text: "\uBA40\uB9AC\uC11C \uC544\uC774 \uC6C3\uC74C\uC18C\uB9AC\uAC00 \uB4E4\uB824\uC628
    \uC21C\uAC04, \uC55E\uC11C \uAC77\uB358 \uD759\uC778\uD615\uC758 \uC5B4\uAE68\uAC00
    \uBBF8\uC138\uD558\uAC8C \uC6C0\uCC14\uAC70\uB838\uB2E4. \uB4A4\uB3CC\uC544\uBCF4\uC9C0\uB294
