  text: "\uC804\uB9AC\uD488\uC744 \uB098\uB204\uB358 \uC911, \uD759\uC778\uD615 \uD558\uB098\uAC00
    \uB2E4 \uD574\uC9C4 \uB0A1\uC740 \uC190\uC218\uAC74 \uD55C \uC7A5\uC744 \uC720\uB3C5
