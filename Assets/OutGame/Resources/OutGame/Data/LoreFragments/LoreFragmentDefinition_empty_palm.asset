  fragmentId: empty_palm
  text: "\uD734\uC2DD \uC911\uC774\uB358 \uD759\uC778\uD615 \uD558\uB098\uAC00, \uC81C
    \uC190\uBC14\uB2E5\uC744 \uC624\uB798\uB3C4\uB85D \uB4E4\uC5EC\uB2E4\uBCF8\uB2E4.
    \uAD73\uC740\uC0B4\uB3C4, \uC0C1\uCC98\uB3C4 \uC5C6\uB294 \uB9E4\uB048\uD55C
    \uD759 \uC190\uC744. \uBB34\uC5C7\uC744 \uCC3E\uB294 \uB4EF\uD558\uB2E4\uAC00,
    \uACB0\uAD6D \uC544\uBB34\uAC83\uB3C4 \uCC3E\uC9C0 \uBABB\uD55C \uCC44 \uC190\uC744
    \uB0B4\uB9B0\uB2E4."
