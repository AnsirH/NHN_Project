  m_Name: LoreFragmentDefinition_stargazing
  m_EditorClassIdentifier: OutGame.ScriptableObjects::OutGame.ScriptableObjects.LoreFragmentDefinition
  fragmentId: stargazing
  text: "\uBC24\uC774 \uAE4A\uC5B4\uB3C4 \uD759\uC778\uD615\uB4E4\uC740 \uC7A0\uB4E4\uC9C0
    \uC54A\uB294\uB2E4. \uADF8\uB7F0\uB370 \uC624\uB298\uC740 \uD55C \uD759\uC778\uD615\uC774
    \uC720\uB3C5 \uC624\uB798\uB3C4\uB85D \uD558\uB298\uC744 \uC62C\uB824\uB2E4\uBCF4\uACE0
    \uC788\uB2E4. \uBCC4\uC744 \uC138\uB294 \uAC83\uB3C4, \uBB34\uC5B8\uAC00\uB97C
    \uAE30\uB2E4\uB9AC\uB294 \uAC83\uB3C4 \uC544\uB2C8\uB2E4. \uADF8\uC800, \uBC14\uB77C\uBCF4\uACE0
    \uC788\uC744 \uBFD0\uC774\uB2E4."
