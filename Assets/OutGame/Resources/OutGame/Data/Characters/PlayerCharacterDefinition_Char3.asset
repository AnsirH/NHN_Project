  characterId: char_3
  displayName: "\uC2DC\uADF8\uBC14\uB974\uB4DC(Sigvard)"
  description: "\uBCF5\uC6D0 \uC758\uC2DD \uC790\uCCB4\uAC00 \uC633\uC9C0 \uC54A\uB2E4 \uC5EC\uACA8 \uADF8 \uADFC\uC6D0\uC744 \uB04A\uC73C\uB824\uB294 \uB178\uC7A5. \uC544\uC774\uB7EC\uB2C8\uD558\uAC8C\uB3C4, \uD759\uC778\uD615\uC744 \uC6C0\uC9C1\uC77C \uC218 \uC788\uB294 \uAC74 \uC9C4\uC9DC \uC758\uC9C0\uB97C \uAC00\uC9C4 \uADF8\uC758 \uD568\uC131\uBFD0\uC774\uB2E4."
