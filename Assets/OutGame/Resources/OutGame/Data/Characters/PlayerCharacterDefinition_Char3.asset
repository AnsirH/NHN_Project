  icon: {fileID: 21300000, guid: 09d5cd1a046ae6f40816e8196a15b3f3, type: 3}
  skillId: skill_char_3
  skillName: "\uC804\uD22C \uD568\uC131"
  skillDescription: "\uD3EC\uD6A8\uB85C \uC544\uAD70\uC744 \uB4A4\uD754\uB4E0\uB2E4 \u2014 \uC758\uC2DD\uC744 \uB05D\uB0B4\uAE30 \uC704\uD574, \uADF8\uB294 \uC624\uB298\uB3C4 \uC0C8\uB85C\uC6B4 \uBCF5\uC6D0\uC790\uAC00 \uB418\uC5B4 \uBD80\uB300\uB97C \uC774\uB048\uB2E4."
