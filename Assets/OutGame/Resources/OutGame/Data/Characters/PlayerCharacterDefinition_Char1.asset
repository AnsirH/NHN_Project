  skillName: "\uB3C5\uAD6C\uB984"
  skillDescription: "\uC801\uC744 \uC11C\uC11C\uD788 \uBB34\uB108\uB728\uB9AC\uB294 \uB3C5\uC744 \uD37C\uB728\uB9B0\uB2E4 \u2014 \uADF8 \uB3C5\uC774 \uC2A4\uBA70\uB4E0 \uB545\uC774 \uB2E4\uC74C \uD759\uC778\uD615\uC758
