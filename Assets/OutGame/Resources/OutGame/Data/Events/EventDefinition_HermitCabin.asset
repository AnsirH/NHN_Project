  m_Name: EventDefinition_HermitCabin
  m_EditorClassIdentifier: OutGame.ScriptableObjects::OutGame.ScriptableObjects.EventDefinition
  eventId: evt_hermit_cabin
  illustration: {fileID: 21300000, guid: b37cf791f3d021c45b8183b5bea4f5e2, type: 3}
  bodyText: "\uC778\uC801 \uC5C6\uB294 \uACE8\uC9DC\uAE30 \uAE4A\uC219\uD55C \uACF3,
    \uB0A1\uC740 \uC624\uB450\uB9C9 \uC790\uB9AC\uC5D0 \uD759\uC778\uD615 \uC5EC\uB7FF\uC774
    \uC904\uC9C0\uC5B4 \uC11C \uC788\uB2E4. \uC774\uAC78 \uBE5A\uC740 \uC190\uC740
    \uC774\uBBF8 \uC624\uB798\uC804\uC5D0 \uC0AC\uB77C\uC84C\uC9C0\uB9CC \uADF8 \uC190\uC774
    \uB2F9\uC2E0\uACFC \uAC19\uC740 \uC77C\uC744 \uD588\uB2E4\uB294 \uC0AC\uC2E4\uB9CC\uC740,
    \uBD80\uC815\uD560 \uC218 \uC5C6\uB2E4."
  choices:
  - choiceText: "\uBD80\uB300\uB97C \uAC70\uB454\uB2E4"
    rewards:
    - type: 1
      armyClass: 0
      itemDef: {fileID: 0}
      goldAmount: 0
    resultText: "\uBA85\uB839\uC744 \uB0B4\uB9AC\uC790, \uB0AF\uC120 \uC190\uC5D0
      \uC758\uD574 \uBE5A\uC5B4\uC84C\uB358 \uD759\uC778\uD615\uB4E4\uC774 \uB9DD\uC124\uC784
      \uC5C6\uC774 \uB2F9\uC2E0\uC744 \uB530\uB790\uB2E4."
  - choiceText: "\uAC74\uB4DC\uB9AC\uC9C0 \uC54A\uACE0 \uC790\uB9AC\uB97C \uB72C\uB2E4"
    rewards:
    - type: 3
      armyClass: 0
      itemDef: {fileID: 0}
      goldAmount: 25
    resultText: "\uC624\uB450\uB9C9 \uC794\uD574 \uC18D\uC5D0\uC11C, \uB204\uAD70\uAC00
      \uC624\uB798 \uB9E4\uB9CC\uC84C\uC744 \uB0A1\uC740 \uC5F0\uC7A5 \uD558\uB098\uB97C
      \uBC1C\uACAC\uD588\uB2E4."
