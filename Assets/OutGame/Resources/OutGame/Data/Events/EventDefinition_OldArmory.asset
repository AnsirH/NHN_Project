  m_Script: {fileID: 11500000, guid: 7893b1a0715f4c44498cf519e61fe537, type: 3}
  m_Name: EventDefinition_OldArmory
  m_EditorClassIdentifier: OutGame.ScriptableObjects::OutGame.ScriptableObjects.EventDefinition
  eventId: evt_old_armory
  illustration: {fileID: 0}
  bodyText: "\uB0A1\uC740 \uBB34\uAE30\uACE0 \uC548, \uBA3C\uC9C0 \uC313\uC778 \uC7A5\uBE44\uB4E4\uC774
    \uC904\uC9C0\uC5B4 \uC788\uB2E4. \uC0AC\uB78C\uB4E4\uC758 \uAE30\uC5B5\uC5D0\uC11C
    \uC78A\uD600\uC9C4 \uACF5\uAC04\uC774\uC9C0\uB9CC \uB0B4\uBD80\uB294 \uBC18\uB4EF\uD558\uAC8C
    \uC815\uB3C8\uB418\uC5B4 \uC788\uB2E4."
  choices:
  - choiceText: "\uAC80\uACFC \uBC29\uD328\uB97C \uCC59\uAE34\uB2E4"
    rewards:
    - type: 2
      armyClass: 0
      itemDef: {fileID: 11400000, guid: 61d51b3066726404b810295714b8b94d, type: 2}
      goldAmount: 0
    resultText: "\uD45C\uBA74\uC740 \uB179\uC2AC\uC5C8\uC9C0\uB9CC, \uC190\uC7A1\uC774\uB9CC\uC740
      \uB204\uAD70\uAC00 \uC624\uB798 \uC950\uACE0 \uC788\uC5C8\uB358 \uB4EF \uB9E4\uB048\uD558\uB2E4."
  - choiceText: "\uB2E8\uAC80\uC744 \uCC59\uAE34\uB2E4"
    rewards:
    - type: 2
      armyClass: 0
      itemDef: {fileID: 11400000, guid: aee08893f5754a90729addca8e31ed1d, type: 2}
      goldAmount: 0
    resultText: "\uC9E7\uC740 \uCE7C\uB0A0\uC774 \uC18C\uB9AC \uC5C6\uC774 \uBE5B\uC744
      \uBC18\uC0AC\uD55C\uB2E4 \u2014 \uC6D0\uB798 \uADF8\uB807\uAC8C \uC4F0\uC600\uC744
      \uAC83\uCC98\uB7FC."
  - choiceText: "\uD65C\uC744 \uCC59\uAE34\uB2E4"
    rewards:
    - type: 2
      armyClass: 0
      itemDef: {fileID: 11400000, guid: 69f7fb86cb054f14bb8ff5bbb6981409, type: 2}
      goldAmount: 0
    resultText: "\uC2DC\uC704\uB294 \uC0AD\uC558\uC9C0\uB9CC, \uD65C\uB300\uB294
      \uC5EC\uC804\uD788 \uACE7\uB2E4."
