  eventId: evt_village_rune_soil
  illustration: {fileID: 21300000, guid: 12d92c740bf97754985f151530016dc4, type: 3}
  bodyText: "\uC57D\uD0C8\uB85C \uBB34\uB108\uC9C4 \uB9C8\uC744 \uBC14\uB2E5 \uC544\uB798,
    \uB8EC\uC758 \uAE30\uC6B4\uC774 \uC605\uAC8C \uB0A8\uC740 \uD759\uC774 \uB4DC\uB7EC\uB0AC\uB2E4.
    \uB9C8\uC744\uC774 \uC138\uC6CC\uC9C0\uAE30 \uD6E8\uC52C \uC804\uBD80\uD130,
    \uC774 \uB545\uC5D0 \uBC30\uC5B4 \uC788\uB358 \uAC83\uC774\uB2E4."
  choices:
  - choiceText: "\uD759\uC744 \uBE5A\uC5B4 \uBD80\uB300\uB85C \uC138\uC6B4\uB2E4"
    rewards:
    - type: 1
      armyClass: 0
      itemDef: {fileID: 0}
      goldAmount: 0
    resultText: "\uD759\uC5D0 \uC190\uC744 \uC5B9\uC790, \uC624\uB798 \uC7A0\uB4E4\uC5B4
      \uC788\uB358 \uD798\uC774 \uC11C\uC11C\uD788 \uC0AC\uB78C\uC758 \uD615\uC0C1\uC744
      \uBE5A\uC5B4\uB0C8\uB2E4."
  - choiceText: "\uAC74\uB4DC\uB9AC\uC9C0 \uC54A\uACE0 \uC9C0\uB098\uAC04\uB2E4"
    rewards:
    - type: 3
      armyClass: 0
      itemDef: {fileID: 0}
      goldAmount: 20
    resultText: "\uBB34\uB108\uC9C4 \uACF3\uAC04 \uD2C8\uC5D0\uC11C, \uCC59\uACA8
      \uAC00\uC9C0 \uBABB\uD55C \uC61B \uC7AC\uD654 \uBA87 \uB2E2\uC744 \uBC1C\uACAC\uD588\uB2E4."
