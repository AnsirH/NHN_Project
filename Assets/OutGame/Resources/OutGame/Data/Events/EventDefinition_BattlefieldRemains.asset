  eventId: evt_battlefield_remains
  illustration: {fileID: 21300000, guid: 731e7f43202a5214aa7d6348571a5473, type: 3}
  bodyText: "\uC9C0\uB09C \uC804\uD22C\uC758 \uD754\uC801\uC774 \uB0A8\uC740 \uB4E4\uD310.
    \uBD80\uC11C\uC9C4 \uB9C8\uCC28 \uC0AC\uC774\uB85C, \uC544\uC9C1 \uC4F8\uB9CC\uD55C
    \uC7A5\uBE44 \uBA87 \uC810\uC774 \uD759\uC5D0 \uBC18\uCBE4 \uD30C\uBB3B\uD600
    \uC788\uB2E4."
  choices:
  - choiceText: "\uB3C4\uB07C\uB97C \uC218\uC2B5\uD55C\uB2E4"
    rewards:
    - type: 2
      armyClass: 0
      itemDef: {fileID: 11400000, guid: e15897dd52ccba1574c6c7a0d7d5decf, type: 2}
      goldAmount: 0
    resultText: "\uD759\uC744 \uD138\uC5B4\uB0B4\uC790, \uC774\uAC00 \uB098\uAC00\uC9C0
      \uC54A\uC740 \uB3C4\uB07C \uD55C \uC790\uB8E8\uAC00 \uB098\uC654\uB2E4. \uB204\uAD6C\uC758
      \uAC83\uC774\uC5C8\uB294\uC9C0\uB294, \uC774\uC81C \uC544\uBB34\uB3C4 \uB2F5\uD560
      \uC218 \uC5C6\uB2E4."
  - choiceText: "\uB2E8\uAC80\uC744 \uC218\uC2B5\uD55C\uB2E4"
    rewards:
    - type: 2
      armyClass: 0
      itemDef: {fileID: 11400000, guid: aee08893f5754a90729addca8e31ed1d, type: 2}
      goldAmount: 0
    resultText: "\uD759\uC744 \uD138\uC5B4\uB0B4\uC790, \uB179\uC2AC\uC9C0 \uC54A\uC740
      \uB2E8\uAC80 \uD55C \uC790\uB8E8\uAC00 \uB098\uC654\uB2E4. \uB204\uAD6C\uC758
      \uAC83\uC774\uC5C8\uB294\uC9C0\uB294, \uC774\uC81C \uC544\uBB34\uB3C4 \uB2F5\uD560
      \uC218 \uC5C6\uB2E4."
  - choiceText: "\uAC80\uACFC \uBC29\uD328\uB97C \uC218\uC2B5\uD55C\uB2E4"
    rewards:
    - type: 2
      armyClass: 0
