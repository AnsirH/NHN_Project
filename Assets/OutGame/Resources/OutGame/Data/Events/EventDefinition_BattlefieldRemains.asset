      goldAmount: 0
    resultText: "\uD759\uC744 \uD138\uC5B4\uB0B4\uC790, \uBD80\uC11C\uC9C0\uC9C0
      \uC54A\uC740 \uBC29\uD328 \uD558\uB098\uAC00 \uB098\uC654\uB2E4. \uB204\uAD6C\uC758
